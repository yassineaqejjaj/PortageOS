generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  createdAt   DateTime     @default(now())
  mfaRequired Boolean      @default(false)
  /// active | suspended (suspendu : connexions et sessions refusées, données conservées).
  status          String    @default("active")
  suspendedAt     DateTime?
  suspendedReason String?
  /// Libellé libre de l'offre (aucune grille tarifaire ni facturation SaaS n'existe).
  plan            String?
  /// Quota de membres (invitations en attente comprises) ; null = illimité.
  maxMembers      Int?
  /// Tenant d'exploitation de la plateforme (console opérateur). Posé uniquement par le script de bootstrap : aucune écriture applicative.
  isPlatform      Boolean   @default(false)
  memberships Membership[]
  companies   Company[]
  prospects   Prospect[]
  consultants Consultant[]
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String
  createdAt         DateTime     @default(now())
  disabledAt        DateTime?
  passwordChangedAt DateTime?
  /// TOTP : secret chiffré (AES-256-GCM, clé MFA_ENCRYPTION_KEY), jamais en clair.
  mfaSecretEnc      String?
  mfaPendingEnc     String?
  mfaEnabledAt      DateTime?
  mfaLastStep       Int?
  recoveryHashes    String[]
  sessions          Session[]
  memberships       Membership[]
}

/// Un utilisateur peut avoir plusieurs sociétés (tenants) avec des rôles distincts.
model Membership {
  id           String   @id @default(uuid())
  userId       String
  tenantId     String
  roles        String[]
  /// Portail client : l'utilisateur n'accède qu'aux données de cette entreprise.
  companyId    String?
  /// Portail consultant : l'utilisateur n'accède qu'à son propre dossier.
  consultantId String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
}

/// Entreprise cliente (premier objet métier tenant-scopé, protégé par RLS).
model Company {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  siren     String?
  /// Délai de paiement convenu (jours), saisi : aucune règle légale codée.
  paymentTermsDays Int?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  missions  Mission[]

  @@unique([tenantId, siren])
  @@index([tenantId])
}

/// Piste d'audit append-only (UPDATE/DELETE interdits par trigger).
model AuditEvent {
  id       String   @id @default(uuid())
  tenantId String
  actorId  String?
  action   String
  entity   String
  entityId String?
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([tenantId, at])
}

/// Prospect CRM (consultant ou entreprise). Étapes pilotées par la machine d'état du domaine.
model Prospect {
  id          String    @id @default(uuid())
  tenantId    String
  kind        String
  name        String
  email       String?
  phone       String?
  source      String?
  stage       String    @default("new")
  lostReason  String?
  campaignId  String?
  importJobId String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, stage])
}

model Consultant {
  id               String           @id @default(uuid())
  tenantId         String
  firstName        String
  lastName         String
  email            String?
  status           String           @default("onboarding")
  sourceProspectId String?          @unique
  createdAt        DateTime         @default(now())
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  tasks            OnboardingTask[]
  missions         Mission[]

  @@index([tenantId, status])
}

/// Checklist d'onboarding : cases cochées par un humain. Aucune vérification externe n'est effectuée (DPAE, signatures : non connectés).
model OnboardingTask {
  id           String     @id @default(uuid())
  tenantId     String
  consultantId String
  key          String
  label        String
  required     Boolean    @default(true)
  doneAt       DateTime?
  doneBy       String?
  consultant   Consultant @relation(fields: [consultantId], references: [id])

  @@unique([consultantId, key])
}

model Mission {
  id              String      @id @default(uuid())
  tenantId        String
  consultantId    String
  companyId       String
  title           String
  dailyRate       Decimal     @db.Decimal(12, 2)
  /// Taux de TVA saisi explicitement (aucun taux légal codé en dur).
  vatRate         Decimal     @db.Decimal(5, 2)
  startDate       DateTime    @db.Date
  endDate         DateTime?   @db.Date
  agreementId     String?
  agreementRateId String?
  purchaseOrderId String?
  /// Unité de saisie du CRA : day | hour | forfait_jours. Pour « hour », dailyRate est le tarif HORAIRE (le nom de colonne est historique).
  timeUnit        String      @default("day")
  /// Plafond annuel de jours du forfait, SAISI par l'administrateur (aucune valeur légale n'est présumée) : informatif, non bloquant.
  annualDaysCap   Int?
  /// Budget HT de la mission (saisi par avenant) : suivi informatif, non bloquant.
  budgetAmount    Decimal?    @db.Decimal(14, 2)
  status          String      @default("active")
  createdAt       DateTime    @default(now())
  consultant      Consultant  @relation(fields: [consultantId], references: [id])
  company         Company     @relation(fields: [companyId], references: [id])
  timesheets      Timesheet[]
  amendments      MissionAmendment[]

  @@index([tenantId, status])
}

model Timesheet {
  id           String          @id @default(uuid())
  tenantId     String
  missionId    String
  period       String
  status       String          @default("draft")
  rejectReason String?
  submittedAt  DateTime?
  decidedAt    DateTime?
  decidedBy    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  mission      Mission         @relation(fields: [missionId], references: [id])
  lines        TimesheetLine[]
  invoice      Invoice?

  @@unique([missionId, period])
  @@index([tenantId, status])
}

model TimesheetLine {
  id          String    @id @default(uuid())
  tenantId    String
  timesheetId String
  date        DateTime  @db.Date
  quantity    Decimal   @db.Decimal(5, 2)
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@unique([timesheetId, date])
}

model InvoiceSequence {
  tenantId String
  series   String
  year     Int
  last     Int    @default(0)

  @@id([tenantId, series, year])
}

model Invoice {
  id             String    @id @default(uuid())
  tenantId       String
  number         String?
  series         String    @default("FA")
  companyId      String
  missionId      String
  timesheetId    String    @unique
  status         String    @default("draft")
  issueDate      DateTime? @db.Date
  days           Decimal   @db.Decimal(8, 2)
  unitPrice      Decimal   @db.Decimal(12, 2)
  vatRate        Decimal   @db.Decimal(5, 2)
  net            Decimal   @db.Decimal(14, 2)
  vat            Decimal   @db.Decimal(14, 2)
  gross          Decimal   @db.Decimal(14, 2)
  paid           Decimal   @default(0) @db.Decimal(14, 2)
  /// Transmission via plateforme agréée : NON connectée.
  einvoiceStatus String    @default("not_connected")
  createdAt      DateTime  @default(now())
  timesheet      Timesheet @relation(fields: [timesheetId], references: [id])
  payments       Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model Payment {
  id         String   @id @default(uuid())
  tenantId   String
  invoiceId  String
  amount     Decimal  @db.Decimal(14, 2)
  receivedOn DateTime @db.Date
  reference  String?
  createdAt  DateTime @default(now())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

/// Journal comptable interne, append-only, équilibré (contrôle en base à la validation de la transaction).
model JournalEntry {
  id           String        @id @default(uuid())
  tenantId     String
  key          String
  consultantId String?
  valueDate    DateTime      @db.Date
  label        String
  sourceType   String
  sourceId     String
  reversalOf   String?       @unique
  reason       String?
  createdAt    DateTime      @default(now())
  lines        JournalLine[]

  @@unique([tenantId, key])
  @@index([tenantId, sourceType, sourceId])
}

model JournalLine {
  id       String       @id @default(uuid())
  tenantId String
  entryId  String
  account  String
  debit    Decimal      @default(0) @db.Decimal(14, 2)
  credit   Decimal      @default(0) @db.Decimal(14, 2)
  entry    JournalEntry @relation(fields: [entryId], references: [id])

  @@index([entryId])
}

/// Paramètres réglementaires/métier datés, sourcés, approuvés à 4 yeux. AUCUNE valeur légale n'est livrée : à saisir depuis des sources officielles.
model RuleParameter {
  id            String    @id @default(uuid())
  tenantId      String
  key           String
  value         String
  unit          String
  validFrom     DateTime  @db.Date
  validTo       DateTime? @db.Date
  source        String
  justification String?
  status        String    @default("draft")
  createdBy     String
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId, key, status])
}

model ExpenseClaim {
  id           String        @id @default(uuid())
  tenantId     String
  consultantId String
  ownerUserId  String
  title        String
  status       String        @default("draft")
  rejectReason String?
  total        Decimal       @default(0) @db.Decimal(12, 2)
  submittedAt  DateTime?
  decidedAt    DateTime?
  decidedBy    String?
  reimbursedAt DateTime?
  createdAt    DateTime      @default(now())
  lines        ExpenseLine[]

  @@index([tenantId, status])
}

model ExpenseLine {
  id          String       @id @default(uuid())
  tenantId    String
  claimId     String
  date        DateTime     @db.Date
  category    String
  description String
  amount      Decimal      @db.Decimal(10, 2)
  km          Decimal?     @db.Decimal(8, 1)
  /// Référence du justificatif (nom/numéro). Le dépôt de fichier et l'OCR ne sont pas implémentés.
  receiptRef  String?
  rebillable  Boolean      @default(false)
  policyFlag  String?
  fingerprint String
  claim       ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([tenantId, fingerprint])
}

model CreditNote {
  id        String   @id @default(uuid())
  tenantId  String
  invoiceId String   @unique
  number    String
  issueDate DateTime @db.Date
  net       Decimal  @db.Decimal(14, 2)
  vat       Decimal  @db.Decimal(14, 2)
  gross     Decimal  @db.Decimal(14, 2)
  reason    String
  createdBy String
  createdAt DateTime @default(now())

  @@unique([tenantId, number])
}

model ContractTemplate {
  id        String     @id @default(uuid())
  tenantId  String
  kind      String
  name      String
  version   Int
  body      String
  variables String[]
  status    String     @default("draft")
  createdBy String
  createdAt DateTime   @default(now())
  contracts Contract[]

  @@unique([tenantId, name, version])
}

model Contract {
  id                String           @id @default(uuid())
  tenantId          String
  templateId        String
  kind              String
  consultantId      String?
  companyId         String?
  status            String           @default("draft")
  renderedBody      String
  variableValues    Json
  sentAt            DateTime?
  signedAt          DateTime?
  /// Aucun fournisseur de signature électronique n'est connecté : la signature est une déclaration interne, non qualifiée.
  signatureProvider String           @default("none")
  signatureEvidence String?
  createdBy         String
  createdAt         DateTime         @default(now())
  template          ContractTemplate @relation(fields: [templateId], references: [id])

  @@index([tenantId, status])
}

model LeaveRequest {
  id                 String    @id @default(uuid())
  tenantId           String
  consultantId       String
  ownerUserId        String
  type               String
  startDate          DateTime  @db.Date
  endDate            DateTime  @db.Date
  halfStart          Boolean   @default(false)
  halfEnd            Boolean   @default(false)
  days               Decimal   @db.Decimal(4, 1)
  /// Faux si aucun jour férié approuvé n'était paramétré sur la période : le décompte peut alors surestimer les jours.
  holidaysConfigured Boolean   @default(false)
  status             String    @default("submitted")
  reason             String?
  rejectReason       String?
  decidedBy          String?
  decidedAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([tenantId, status])
  @@index([consultantId, startDate])
}

/// Ajustements de solde saisis par la RH (solde initial, acquisition, correction) : append-only, motivés, audités.
model LeaveAdjustment {
  id           String   @id @default(uuid())
  tenantId     String
  consultantId String
  days         Decimal  @db.Decimal(5, 1)
  reason       String
  createdBy    String
  createdAt    DateTime @default(now())

  @@index([consultantId])
}

/// Exécution d'un agent (playbook déterministe). Aucun fournisseur LLM n'est connecté : usage = {provider:"none"}.
model AgentRun {
  id            String          @id @default(uuid())
  tenantId      String
  agentKey      String
  playbook      String
  params        Json
  status        String          @default("running")
  createdBy     String
  toolCallCount Int             @default(0)
  summary       Json?
  usage         Json
  error         String?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  toolCalls     AgentToolCall[]
  proposals     AgentProposal[]

  @@index([tenantId, startedAt])
}

/// Journal des appels d'outils (append-only) : lectures et propositions.
model AgentToolCall {
  id        String   @id @default(uuid())
  tenantId  String
  runId     String
  tool      String
  kind      String
  input     Json
  output    Json?
  status    String
  createdAt DateTime @default(now())
  run       AgentRun @relation(fields: [runId], references: [id])

  @@index([runId])
}

/// Action d'écriture PROPOSÉE par un agent ; rien n'est exécuté sans approbation humaine. tool/input immuables.
model AgentProposal {
  id                String          @id @default(uuid())
  tenantId          String
  runId             String
  tool              String
  input             Json
  summary           String
  riskAmount        Decimal?        @db.Decimal(14, 2)
  requiredApprovals Int             @default(1)
  status            String          @default("pending")
  result            Json?
  error             String?
  createdAt         DateTime        @default(now())
  decidedAt         DateTime?
  run               AgentRun        @relation(fields: [runId], references: [id])
  approvals         AgentApproval[]

  @@index([tenantId, status])
}

model AgentApproval {
  id         String        @id @default(uuid())
  tenantId   String
  proposalId String
  userId     String
  decision   String
  comment    String?
  createdAt  DateTime      @default(now())
  proposal   AgentProposal @relation(fields: [proposalId], references: [id])

  @@unique([proposalId, userId])
}

model AgentConfig {
  tenantId           String
  agentKey           String
  enabled            Boolean @default(true)
  maxToolCallsPerRun Int     @default(50)
  maxRunsPerDay      Int     @default(20)

  @@id([tenantId, agentKey])
}

model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  tenantId String
  userId   String
  type     String
  enabled  Boolean

  @@id([userId, tenantId, type])
}

model SupportTicket {
  id              String           @id @default(uuid())
  tenantId        String
  requesterUserId String
  subject         String
  category        String
  priority        String           @default("normal")
  status          String           @default("open")
  assigneeUserId  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  closedAt        DateTime?
  messages        SupportMessage[]

  @@index([tenantId, status])
  @@index([requesterUserId])
}

/// Messages de support : append-only. `internal` = note réservée au personnel (jamais visible du demandeur).
model SupportMessage {
  id           String        @id @default(uuid())
  tenantId     String
  ticketId     String
  authorUserId String
  body         String
  internal     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  ticket       SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
}

model MessageTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  body      String
  createdBy String
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
}

/// Session = jeton de rafraîchissement opaque (haché) avec rotation et détection de rejeu.
model Session {
  id              String    @id @default(uuid())
  userId          String
  tenantId        String
  refreshHash     String    @unique
  prevRefreshHash String?
  prevRotatedAt   DateTime?
  userAgent       String?
  mfaVerified     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedReason   String?
  user            User      @relation(fields: [userId], references: [id])

  @@index([userId, tenantId])
}

/// Invitation (ou lien de réinitialisation) à usage unique : seul le HACHÉ du jeton est stocké.
model Invitation {
  id           String    @id @default(uuid())
  tenantId     String
  kind         String    @default("invite")
  email        String
  roles        String[]
  companyId    String?
  consultantId String?
  tokenHash    String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdBy    String
  createdAt    DateTime  @default(now())

  @@index([tenantId, email])
}

/// Plan comptable par société. Les comptes « système » sont ceux utilisés par les flux automatiques ; le plan par défaut est à valider par l'expert-comptable.
model Account {
  id        String   @id @default(uuid())
  tenantId  String
  code      String
  label     String
  type      String
  system    Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, code])
}

/// Clôture mensuelle : une période close n'accepte plus aucune écriture (appliqué par l'application ET par un trigger).
model ClosingPeriod {
  id           String    @id @default(uuid())
  tenantId     String
  period       String
  status       String    @default("closed")
  closedBy     String
  closedAt     DateTime  @default(now())
  reopenedBy   String?
  reopenedAt   DateTime?
  reopenReason String?

  @@unique([tenantId, period])
}

/// Document privé (métadonnées). Le contenu est dans DocumentBlob. Les métadonnées sont figées (trigger) ; seules la suppression logique et la purge évoluent.
model Document {
  id           String        @id @default(uuid())
  tenantId     String
  ownerType    String
  ownerId      String
  category     String
  name         String
  mime         String
  size         Int
  sha256       String
  scanStatus   String
  scanEngine   String?
  uploadedBy   String
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  purgedAt     DateTime?
  /// db (contenu dans DocumentBlob) | s3 (stockage objet, clé storageKey)
  storageDriver String       @default("db")
  storageKey   String?
  blob         DocumentBlob?

  @@index([tenantId, ownerType, ownerId])
}

model DocumentBlob {
  documentId String   @id
  tenantId   String
  data       Bytes
  document   Document @relation(fields: [documentId], references: [id])
}

model Campaign {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  kind      String
  channel   String
  status    String    @default("draft")
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  budget    Decimal?  @db.Decimal(12, 2)
  createdBy String
  createdAt DateTime  @default(now())

  @@unique([tenantId, name])
}

/// Interactions : journal append-only (jamais modifiées).
model Interaction {
  id         String   @id @default(uuid())
  tenantId   String
  prospectId String
  type       String
  summary    String
  occurredAt DateTime
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([prospectId, occurredAt])
}

model CrmTask {
  id             String    @id @default(uuid())
  tenantId       String
  prospectId     String?
  title          String
  dueDate        DateTime  @db.Date
  assigneeUserId String
  status         String    @default("open")
  doneAt         DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())

  @@index([tenantId, assigneeUserId, status])
}

/// Apporteur d'affaires (introducer) ou parrain (sponsor).
model Referrer {
  id           String     @id @default(uuid())
  tenantId     String
  kind         String
  name         String
  email        String?
  consultantId String?
  status       String     @default("active")
  createdBy    String
  createdAt    DateTime   @default(now())
  referrals    Referral[]

  @@unique([tenantId, name])
}

/// La règle de commission est convenue et FIGÉE à la création du parrainage (auditable).
model Referral {
  id             String       @id @default(uuid())
  tenantId       String
  referrerId     String
  prospectId     String       @unique
  ruleType       String
  ruleValue      Decimal      @db.Decimal(12, 2)
  durationMonths Int          @default(0)
  convertedAt    DateTime?
  consultantId   String?
  companyId      String?
  createdBy      String
  createdAt      DateTime     @default(now())
  referrer       Referrer     @relation(fields: [referrerId], references: [id])
  commissions    Commission[]
}

model Commission {
  id            String    @id @default(uuid())
  tenantId      String
  referralId    String
  sourceType    String
  sourceId      String
  amount        Decimal   @db.Decimal(12, 2)
  status        String    @default("accrued")
  approvedBy    String?
  approvedAt    DateTime?
  paidAt        DateTime?
  paidReference String?
  createdAt     DateTime  @default(now())
  referral      Referral  @relation(fields: [referralId], references: [id])

  @@unique([referralId, sourceType, sourceId])
  @@index([tenantId, status])
}

model FrameworkAgreement {
  id               String          @id @default(uuid())
  tenantId         String
  companyId        String
  name             String
  startDate        DateTime        @db.Date
  endDate          DateTime        @db.Date
  status           String          @default("draft")
  paymentTermsDays Int?
  notes            String?
  createdBy        String
  createdAt        DateTime        @default(now())
  rates            FrameworkRate[]

  @@index([tenantId, companyId])
}

model FrameworkRate {
  id           String             @id @default(uuid())
  tenantId     String
  agreementId  String
  label        String
  maxDailyRate Decimal            @db.Decimal(12, 2)
  agreement    FrameworkAgreement @relation(fields: [agreementId], references: [id])

  @@unique([agreementId, label])
}

model ImportJob {
  id           String    @id @default(uuid())
  tenantId     String
  kind         String
  status       String    @default("previewed")
  fileName     String?
  campaignId   String?
  defaultKind  String
  mapping      Json
  rowsTotal    Int
  rowsValid    Int
  rowsInvalid  Int
  report       Json
  validRows    Json
  createdBy    String
  createdAt    DateTime  @default(now())
  committedAt  DateTime?
  rolledBackAt DateTime?

  @@index([tenantId, createdAt])
}

/// Simulations enregistrées (historique append-only).
model Simulation {
  id         String   @id @default(uuid())
  tenantId   String
  prospectId String?
  inputs     Json
  results    Json
  createdBy  String
  createdAt  DateTime @default(now())
}

model ScoringConfig {
  tenantId  String   @id
  weights   Json
  updatedBy String
  updatedAt DateTime @default(now())
}

model CompanyContact {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String
  name      String
  email     String?
  phone     String?
  /// billing | operations | signatory | other
  role      String
  isPrimary Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())

  @@index([tenantId, companyId])
}

model CompanySite {
  id         String    @id @default(uuid())
  tenantId   String
  companyId  String
  label      String
  address    String
  postalCode String
  city       String
  country    String    @default("FR")
  archivedAt DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())

  @@index([tenantId, companyId])
}

/// Bon de commande client : plafond d'engagement, consommation calculée depuis les factures émises.
model PurchaseOrder {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String
  reference String
  amount    Decimal  @db.Decimal(14, 2)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  /// open | closed | cancelled
  status    String   @default("open")
  createdBy String
  createdAt DateTime @default(now())

  @@unique([tenantId, companyId, reference])
  @@index([tenantId, companyId])
}

/// Journal de livraison des e-mails : AUCUN contenu ni jeton n'est conservé (les liens de réinitialisation ne doivent pas être relisibles).
model EmailOutbox {
  id        String   @id @default(uuid())
  tenantId  String?
  toHash    String
  template  String
  /// sent | failed | not_connected
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// Import de relevé bancaire (CSV) : aperçu puis validation. Aucune connexion bancaire.
model BankImport {
  id          String    @id @default(uuid())
  tenantId    String
  fileName    String?
  /// previewed | committed | cancelled
  status      String    @default("previewed")
  rowsTotal   Int
  rowsValid   Int
  rowsInvalid Int
  report      Json
  rows        Json
  mapping     Json
  createdBy   String
  createdAt   DateTime  @default(now())
  committedAt DateTime?
}

/// Ligne de relevé. Montant signé (crédit > 0). Empreinte unique par société : un même mouvement n'est jamais importé deux fois.
model BankTransaction {
  id          String   @id @default(uuid())
  tenantId    String
  importId    String
  date        DateTime @db.Date
  label       String
  reference   String?
  amount      Decimal  @db.Decimal(14, 2)
  fingerprint String
  /// unmatched | matched | ignored
  status      String   @default("unmatched")
  paymentId   String?
  note        String?
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime @default(now())

  @@unique([tenantId, fingerprint])
  @@index([tenantId, status])
}

/// Ligne de facture : quantité × prix unitaire, TVA par ligne (taux saisi, jamais codé en dur). Figée dès que la facture n'est plus un brouillon.
model InvoiceLine {
  id          String   @id @default(uuid())
  tenantId    String
  invoiceId   String
  position    Int
  /// activity (issue du CRA, non supprimable) | extra (ligne ajoutée)
  kind        String   @default("extra")
  description String
  unit        String   @default("jour")
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  vatRate     Decimal  @db.Decimal(5, 2)
  net         Decimal  @db.Decimal(14, 2)
  vat         Decimal  @db.Decimal(14, 2)
  gross       Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())

  @@unique([invoiceId, position])
  @@index([tenantId, invoiceId])
}

/// Identité légale du vendeur (la société de portage), saisie par l'administrateur : apparaît sur les PDF. Aucune mention légale n'est inventée.
model TenantProfile {
  tenantId   String   @id
  legalName  String
  legalForm  String?
  siren      String?
  vatNumber  String?
  address    String?
  postalCode String?
  city       String?
  iban       String?
  updatedBy  String
  updatedAt  DateTime @updatedAt
}

/// Relances CRA : une par mission, période et jour (idempotent), notification interne uniquement (e-mail non connecté pour cet usage).
model TimesheetReminder {
  id        String   @id @default(uuid())
  tenantId  String
  missionId String
  period    String
  day       String
  createdAt DateTime @default(now())

  @@unique([missionId, period, day])
  @@index([tenantId, period])
}

/// Avenant de mission, append-only : rate | extend | early_end | budget. Les anciennes valeurs restent consultables.
model MissionAmendment {
  id            String   @id @default(uuid())
  tenantId      String
  missionId     String
  kind          String
  /// Mois d'effet (AAAA-MM) pour un tarif ; date d'effet (AAAA-MM-JJ) pour une fin ou une prolongation.
  effective     String
  before        Json
  after         Json
  reason        String
  createdBy     String
  createdAt     DateTime @default(now())
  mission       Mission  @relation(fields: [missionId], references: [id])

  @@index([tenantId, missionId])
}

/// Canal WhatsApp d'une société (Meta WhatsApp Cloud API). Le jeton d'accès est chiffré (AES-256-GCM) et n'est jamais renvoyé par l'API.
/// status : configured (identifiants saisis, non vérifiés) | verified (appel réel à Meta réussi) | error | disabled.
model WhatsappChannel {
  tenantId          String   @id
  phoneNumberId     String
  wabaId            String?
  displayPhone      String?
  accessTokenSealed String?
  status            String   @default("configured")
  lastCheckedAt     DateTime?
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Routage des webhooks entrants (le tenant n'est pas connu avant la lecture) : phone_number_id -> tenant. Aucun secret ici, donc pas de RLS.
model WhatsappRoute {
  phoneNumberId String @id
  tenantId      String @unique
}

/// Modèle de message déclaré par la société (nom approuvé côté Meta : non vérifiable par le produit). enabled = envoi automatique autorisé.
model WhatsappTemplate {
  tenantId String
  key      String
  metaName String
  language String  @default("fr")
  enabled  Boolean @default(false)

  @@id([tenantId, key])
}

/// Consentement courant d'une personne (consultant ou contact client) pour un numéro ; les changements sont tracés dans le journal d'audit.
model WhatsappConsent {
  id          String   @id @default(uuid())
  tenantId    String
  subjectType String
  subjectId   String
  phone       String
  status      String
  source      String
  evidence    String?
  recordedBy  String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([tenantId, subjectType, subjectId])
  @@index([tenantId, phone])
}

model WhatsappConversation {
  id            String    @id @default(uuid())
  tenantId      String
  phone         String
  subjectType   String?
  subjectId     String?
  displayName   String?
  lastInboundAt DateTime?
  lastMessageAt DateTime  @default(now())
  unreadCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  messages      WhatsappMessage[]

  @@unique([tenantId, phone])
  @@index([tenantId, lastMessageAt])
}

/// direction in|out ; kind text|template ; status : queued|sending|sent|delivered|read|failed|received|not_connected|simulated.
model WhatsappMessage {
  id                String               @id @default(uuid())
  tenantId          String
  conversationId    String
  direction         String
  kind              String
  templateKey       String?
  templateParams    String[]             @default([])
  body              String
  status            String
  providerMessageId String?
  error             String?
  sentBy            String?
  createdAt         DateTime             @default(now())
  conversation      WhatsappConversation @relation(fields: [conversationId], references: [id])

  @@unique([tenantId, providerMessageId])
  @@index([conversationId, createdAt])
  @@index([tenantId, status])
}
