generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  companies   Company[]
  prospects   Prospect[]
  consultants Consultant[]
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  disabledAt   DateTime?
  memberships  Membership[]
}

/// Un utilisateur peut avoir plusieurs sociétés (tenants) avec des rôles distincts.
model Membership {
  id           String   @id @default(uuid())
  userId       String
  tenantId     String
  roles        String[]
  /// Portail client : l'utilisateur n'accède qu'aux données de cette entreprise.
  companyId    String?
  /// Portail consultant : l'utilisateur n'accède qu'à son propre dossier.
  consultantId String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
}

/// Entreprise cliente (premier objet métier tenant-scopé, protégé par RLS).
model Company {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  siren     String?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  missions  Mission[]

  @@unique([tenantId, siren])
  @@index([tenantId])
}

/// Piste d'audit append-only (UPDATE/DELETE interdits par trigger).
model AuditEvent {
  id       String   @id @default(uuid())
  tenantId String
  actorId  String?
  action   String
  entity   String
  entityId String?
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([tenantId, at])
}

/// Prospect CRM (consultant ou entreprise). Étapes pilotées par la machine d'état du domaine.
model Prospect {
  id         String   @id @default(uuid())
  tenantId   String
  kind       String
  name       String
  email      String?
  phone      String?
  source     String?
  stage      String   @default("new")
  lostReason String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, stage])
}

model Consultant {
  id               String           @id @default(uuid())
  tenantId         String
  firstName        String
  lastName         String
  email            String?
  status           String           @default("onboarding")
  sourceProspectId String?          @unique
  createdAt        DateTime         @default(now())
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  tasks            OnboardingTask[]
  missions         Mission[]

  @@index([tenantId, status])
}

/// Checklist d'onboarding : cases cochées par un humain. Aucune vérification externe n'est effectuée (DPAE, signatures : non connectés).
model OnboardingTask {
  id           String     @id @default(uuid())
  tenantId     String
  consultantId String
  key          String
  label        String
  required     Boolean    @default(true)
  doneAt       DateTime?
  doneBy       String?
  consultant   Consultant @relation(fields: [consultantId], references: [id])

  @@unique([consultantId, key])
}

model Mission {
  id           String      @id @default(uuid())
  tenantId     String
  consultantId String
  companyId    String
  title        String
  dailyRate    Decimal     @db.Decimal(12, 2)
  /// Taux de TVA saisi explicitement (aucun taux légal codé en dur).
  vatRate      Decimal     @db.Decimal(5, 2)
  startDate    DateTime    @db.Date
  endDate      DateTime?   @db.Date
  status       String      @default("active")
  createdAt    DateTime    @default(now())
  consultant   Consultant  @relation(fields: [consultantId], references: [id])
  company      Company     @relation(fields: [companyId], references: [id])
  timesheets   Timesheet[]

  @@index([tenantId, status])
}

model Timesheet {
  id           String          @id @default(uuid())
  tenantId     String
  missionId    String
  period       String
  status       String          @default("draft")
  rejectReason String?
  submittedAt  DateTime?
  decidedAt    DateTime?
  decidedBy    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  mission      Mission         @relation(fields: [missionId], references: [id])
  lines        TimesheetLine[]
  invoice      Invoice?

  @@unique([missionId, period])
  @@index([tenantId, status])
}

model TimesheetLine {
  id          String    @id @default(uuid())
  tenantId    String
  timesheetId String
  date        DateTime  @db.Date
  quantity    Decimal   @db.Decimal(3, 1)
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@unique([timesheetId, date])
}

model InvoiceSequence {
  tenantId String
  series   String
  year     Int
  last     Int    @default(0)

  @@id([tenantId, series, year])
}

model Invoice {
  id             String    @id @default(uuid())
  tenantId       String
  number         String?
  series         String    @default("FA")
  companyId      String
  missionId      String
  timesheetId    String    @unique
  status         String    @default("draft")
  issueDate      DateTime? @db.Date
  days           Decimal   @db.Decimal(6, 1)
  unitPrice      Decimal   @db.Decimal(12, 2)
  vatRate        Decimal   @db.Decimal(5, 2)
  net            Decimal   @db.Decimal(14, 2)
  vat            Decimal   @db.Decimal(14, 2)
  gross          Decimal   @db.Decimal(14, 2)
  paid           Decimal   @default(0) @db.Decimal(14, 2)
  /// Transmission via plateforme agréée : NON connectée.
  einvoiceStatus String    @default("not_connected")
  createdAt      DateTime  @default(now())
  timesheet      Timesheet @relation(fields: [timesheetId], references: [id])
  payments       Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model Payment {
  id         String   @id @default(uuid())
  tenantId   String
  invoiceId  String
  amount     Decimal  @db.Decimal(14, 2)
  receivedOn DateTime @db.Date
  reference  String?
  createdAt  DateTime @default(now())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

/// Journal comptable interne, append-only, équilibré (contrôle en base à la validation de la transaction).
model JournalEntry {
  id           String        @id @default(uuid())
  tenantId     String
  key          String
  consultantId String?
  valueDate    DateTime      @db.Date
  label        String
  sourceType   String
  sourceId     String
  reversalOf   String?       @unique
  createdAt    DateTime      @default(now())
  lines        JournalLine[]

  @@unique([tenantId, key])
  @@index([tenantId, sourceType, sourceId])
}

model JournalLine {
  id       String       @id @default(uuid())
  tenantId String
  entryId  String
  account  String
  debit    Decimal      @default(0) @db.Decimal(14, 2)
  credit   Decimal      @default(0) @db.Decimal(14, 2)
  entry    JournalEntry @relation(fields: [entryId], references: [id])

  @@index([entryId])
}

/// Paramètres réglementaires/métier datés, sourcés, approuvés à 4 yeux. AUCUNE valeur légale n'est livrée : à saisir depuis des sources officielles.
model RuleParameter {
  id            String    @id @default(uuid())
  tenantId      String
  key           String
  value         String
  unit          String
  validFrom     DateTime  @db.Date
  validTo       DateTime? @db.Date
  source        String
  justification String?
  status        String    @default("draft")
  createdBy     String
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId, key, status])
}

model ExpenseClaim {
  id           String        @id @default(uuid())
  tenantId     String
  consultantId String
  ownerUserId  String
  title        String
  status       String        @default("draft")
  rejectReason String?
  total        Decimal       @default(0) @db.Decimal(12, 2)
  submittedAt  DateTime?
  decidedAt    DateTime?
  decidedBy    String?
  reimbursedAt DateTime?
  createdAt    DateTime      @default(now())
  lines        ExpenseLine[]

  @@index([tenantId, status])
}

model ExpenseLine {
  id          String       @id @default(uuid())
  tenantId    String
  claimId     String
  date        DateTime     @db.Date
  category    String
  description String
  amount      Decimal      @db.Decimal(10, 2)
  km          Decimal?     @db.Decimal(8, 1)
  /// Référence du justificatif (nom/numéro). Le dépôt de fichier et l'OCR ne sont pas implémentés.
  receiptRef  String?
  rebillable  Boolean      @default(false)
  policyFlag  String?
  fingerprint String
  claim       ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([tenantId, fingerprint])
}

model CreditNote {
  id        String   @id @default(uuid())
  tenantId  String
  invoiceId String   @unique
  number    String
  issueDate DateTime @db.Date
  net       Decimal  @db.Decimal(14, 2)
  vat       Decimal  @db.Decimal(14, 2)
  gross     Decimal  @db.Decimal(14, 2)
  reason    String
  createdBy String
  createdAt DateTime @default(now())

  @@unique([tenantId, number])
}

model ContractTemplate {
  id        String     @id @default(uuid())
  tenantId  String
  kind      String
  name      String
  version   Int
  body      String
  variables String[]
  status    String     @default("draft")
  createdBy String
  createdAt DateTime   @default(now())
  contracts Contract[]

  @@unique([tenantId, name, version])
}

model Contract {
  id                String           @id @default(uuid())
  tenantId          String
  templateId        String
  kind              String
  consultantId      String?
  companyId         String?
  status            String           @default("draft")
  renderedBody      String
  variableValues    Json
  sentAt            DateTime?
  signedAt          DateTime?
  /// Aucun fournisseur de signature électronique n'est connecté : la signature est une déclaration interne, non qualifiée.
  signatureProvider String           @default("none")
  signatureEvidence String?
  createdBy         String
  createdAt         DateTime         @default(now())
  template          ContractTemplate @relation(fields: [templateId], references: [id])

  @@index([tenantId, status])
}
