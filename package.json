{
  "name": "portage-os",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "pnpm install && docker compose up -d",
    "dev": "docker compose up -d && echo 'apps/* non encore implementes - voir docs/IMPLEMENTATION_MATRIX.md'",
    "test": "pnpm -F @portage/domain build && pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -F @portage/domain build && pnpm -r --if-present typecheck",
    "migrate": "pnpm -F @portage/api exec prisma migrate deploy",
    "seed": "pnpm -F @portage/api seed"
  }
}