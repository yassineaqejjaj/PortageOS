# Aucun secret ici. Copier vers .env en local.
DATABASE_URL=postgresql://portage:portage@localhost:5432/portage
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=portage-docs
APP_ENV=dev
# Integrations: laisser vide tant que les acces officiels ne sont pas obtenus (statut = non connecte)
PAYROLL_PROVIDER_API_KEY=
EINVOICE_PLATFORM_API_KEY=
ESIGN_PROVIDER_API_KEY=
# API: DATABASE_URL = propriétaire (migrations, fixtures). APP_DATABASE_URL = rôle portage_app (RLS), mot de passe posé par scripts/db-roles.sh
APP_DATABASE_URL=postgresql://portage_app:CHANGE_ME@localhost:5432/portage
APP_DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
DEMO_PASSWORD=CHANGE_ME_DEMO_ONLY
